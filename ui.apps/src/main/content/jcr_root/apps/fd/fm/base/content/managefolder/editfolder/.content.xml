<?xml version="1.0" encoding="UTF-8"?>
<!--
    Replaces /libs/fd/fm/base/content/managefolder/editfolder (the Forms & Documents folder "Edit" dialog).
    The console includes this dialog by relative path, so this copy shadows the libs one entirely rather
    than merging with it - keep it in sync with /libs on AEM upgrades. Adds the Required Verification Level
    field; the libs editfolder.js only posts jcr:title, so yukon-forms.managefolder loads and saves it.
-->
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:granite="http://www.adobe.com/jcr/granite/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0"
    jcr:primaryType="nt:unstructured"
    sling:resourceType="granite/ui/components/coral/foundation/container">
    <items jcr:primaryType="nt:unstructured">
        <includeclientlibs
            jcr:primaryType="nt:unstructured"
            sling:resourceType="granite/ui/components/coral/foundation/includeclientlibs"
            categories="[fm.base.managefolder,yukon-forms.managefolder]"/>
        <editfolderdialog
            jcr:primaryType="nt:unstructured"
            jcr:title="Edit Folder Title"
            granite:id="fm-id-editfolderdialog"
            closable="{Boolean}true"
            sling:resourceType="granite/ui/components/coral/foundation/dialog">
            <items jcr:primaryType="nt:unstructured">
                <editfolderform
                    jcr:primaryType="nt:unstructured"
                    enctype="application/x-www-form-urlencoded"
                    method="post"
                    maximized="{Boolean}true"
                    style="vertical"
                    sling:resourceType="granite/ui/components/coral/foundation/form">
                    <items jcr:primaryType="nt:unstructured">
                        <editfolderfieldset
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/fieldset">
                            <items jcr:primaryType="nt:unstructured">
                                <title
                                    jcr:primaryType="nt:unstructured"
                                    granite:title="Enter New Title"
                                    name="./jcr:content/jcr:title"
                                    granite:id="fm-id-folder-title"
                                    fieldLabel="Title"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                    autofocus="{Boolean}true"/>
                                <name
                                    jcr:primaryType="nt:unstructured"
                                    disabled="{Boolean}true"
                                    granite:id="fm-id-folder-name"
                                    fieldLabel="Name"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"/>
                                <requiredverificationstatus
                                    jcr:primaryType="nt:unstructured"
                                    granite:id="yf-id-folder-required-verification-status"
                                    fieldLabel="Required Verification Level"
                                    fieldDescription="Minimum level needs to access forms in this folder. 0 = public. 1-3 = the member's verification_status must be at least this level. Not set = inherit from the parent folder."
                                    sling:resourceType="granite/ui/components/coral/foundation/form/select">
                                    <items jcr:primaryType="nt:unstructured">
                                        <inherit
                                            jcr:primaryType="nt:unstructured"
                                            text="Inherit from parent folder"
                                            value=""/>
                                        <level0
                                            jcr:primaryType="nt:unstructured"
                                            text="Public"
                                            value="0"/>
                                        <level1
                                            jcr:primaryType="nt:unstructured"
                                            text="Verification status 1+"
                                            value="1"/>
                                        <level2
                                            jcr:primaryType="nt:unstructured"
                                            text="Verification status 2+"
                                            value="2"/>
                                        <level3
                                            jcr:primaryType="nt:unstructured"
                                            text="Verification status 3+"
                                            value="3"/>
                                    </items>
                                </requiredverificationstatus>
                            </items>
                        </editfolderfieldset>
                    </items>
                </editfolderform>
            </items>
            <footer jcr:primaryType="nt:unstructured">
                <close
                    jcr:primaryType="nt:unstructured"
                    text="Cancel"
                    variant="quiet"
                    sling:resourceType="granite/ui/components/coral/foundation/button">
                    <parentConfig
                        jcr:primaryType="nt:unstructured"
                        close="{Boolean}true"/>
                </close>
                <submit
                    jcr:primaryType="nt:unstructured"
                    trackingElement="Edit Final Button"
                    trackingFeature="Folder"
                    text="Submit"
                    variant="primary"
                    granite:id="fm-id-editfolderproperties-submit"
                    sling:resourceType="granite/ui/components/coral/foundation/button"/>
            </footer>
        </editfolderdialog>
    </items>
</jcr:root>
