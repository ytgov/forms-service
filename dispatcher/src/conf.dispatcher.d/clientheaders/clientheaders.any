#
# This file contains the request headers, and can be customized.
#
# By default, it includes the default client headers.
#

$include "./default_clientheaders.any"

# YUKONAEMF-88: the ygDirectory FDM calls /bin/yukon-forms/ygdirectory/* through the
# public URL; DirectoryLookupServlet needs this header to accept the call.
"X-YG-Directory-Key"
